<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol></defaultcontrol>
	<controls>
		<control type="group" id="0">
			<control type="label" id="10">
				<left>45</left>
				<top>15</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				<font>font12</font>
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label" id="11">
				<left>45</left>
				<top>45</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				<font>font12</font>
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label" id="12">
				<left>45</left>
				<top>75</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				<font>font12</font>
				<shadowcolor>black</shadowcolor>
			</control>
		</control>
		<control type="group" id="1">
			<depth>DepthOSD+</depth>
			<visible>Player.Caching + Integer.IsGreater(Player.CacheLevel,0)</visible>
			<animation effect="fade" delay="300" time="200">Visible</animation>
			<animation effect="fade" delay="200" time="150">Hidden</animation>
			<centerleft>50%</centerleft>
			<width>110</width>
			<centertop>50%</centertop>
			<height>110</height>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>110</width>
				<height>110</height>
				<texture colordiffuse="BFFFFFFF">osd/buffer-bg.png</texture>
			</control>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>92</width>
				<height>92</height>
				<texture>dialogs/extendedprogress/loading-back.png</texture>
			</control>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>92</width>
				<height>92</height>
				<texture colordiffuse="button_focus">$INFO[Player.CacheLevel,dialogs/volume/progress/p,.png]</texture>
			</control>
			<control type="label" id="1">
				<description>buffering value</description>
				<label>$INFO[Player.CacheLevel]</label>
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>200</width>
				<height>200</height>
				<aligny>center</aligny>
				<align>center</align>
				<font>font13</font>
			</control>
		</control>
		<control type="group">
			<description>
				RetroAchievements challenge indicator. Shown while the player is
				inside an attempt at an achievement, so they know the attempt is
				live without opening the achievements dialog. Sits top-right,
				clear of the OSD and of any subtitles.
			</description>
			<visible>!String.IsEmpty(RetroPlayer.AchievementsChallengeTitle)</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
			<right>40</right>
			<top>40</top>
			<width>420</width>
			<height>72</height>
			<control type="image">
				<description>Backdrop, so the indicator stays readable over any game</description>
				<left>0</left>
				<top>0</top>
				<width>420</width>
				<height>72</height>
				<texture border="10" colordiffuse="BB000000">dialogs/dialog-bg-nobo.png</texture>
			</control>
			<control type="image">
				<description>Achievement badge</description>
				<left>10</left>
				<top>10</top>
				<width>52</width>
				<height>52</height>
				<texture background="true">$INFO[RetroPlayer.AchievementsChallengeBadge]</texture>
				<aspectratio>keep</aspectratio>
			</control>
			<control type="label">
				<description>Achievement being attempted</description>
				<left>72</left>
				<top>10</top>
				<width>338</width>
				<height>52</height>
				<label>$INFO[RetroPlayer.AchievementsChallengeTitle]</label>
				<font>font12</font>
				<align>left</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<shadowcolor>black</shadowcolor>
				<scroll>true</scroll>
				<scrollsuffix>   </scrollsuffix>
			</control>
		</control>
		<control type="group">
			<description>
				Leaderboard tracker. While an attempt at a leaderboard runs, the
				client publishes the value as it stands - the lap time so far,
				the score so far - and this shows it. Sits under the challenge
				indicator, and drops to where that one sits when there is none.
			</description>
			<visible>!String.IsEmpty(RetroPlayer.LeaderboardTracker)</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
			<right>40</right>
			<top>40</top>
			<width>420</width>
			<height>56</height>
			<animation effect="slide" end="0,82" time="0" condition="!String.IsEmpty(RetroPlayer.AchievementsChallengeTitle)">Conditional</animation>
			<control type="image">
				<description>Backdrop, so the value stays readable over any game</description>
				<left>0</left>
				<top>0</top>
				<width>420</width>
				<height>56</height>
				<texture border="10" colordiffuse="BB000000">dialogs/dialog-bg-nobo.png</texture>
			</control>
			<control type="label">
				<description>The value as it stands, formatted by the client</description>
				<left>14</left>
				<top>0</top>
				<width>392</width>
				<height>56</height>
				<label>$INFO[RetroPlayer.LeaderboardTracker]</label>
				<font>font13</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<shadowcolor>black</shadowcolor>
			</control>
		</control>
	</controls>
</window>
