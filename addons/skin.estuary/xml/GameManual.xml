<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<!-- The page is read against a plain dark background rather than the game,
		     which would show through and make the scanned paper hard to read -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>100%</height>
			<texture colordiffuse="black">colors/white.png</texture>
		</control>

		<control type="group">
			<animation effect="fade" time="200">WindowOpen</animation>
			<animation effect="fade" time="200">WindowClose</animation>

			<!-- The page. keepaspectratio so a portrait page and a double page
			     spread are both shown whole, letterboxed into the same space. -->
			<control type="image" id="9000">
				<left>60</left>
				<top>40</top>
				<width>1800</width>
				<height>940</height>
				<aspectratio>keep</aspectratio>
				<texture background="true">$INFO[Window.Property(Manual.Image)]</texture>
			</control>

			<!-- Shown while the document is being read. Opening happens on a
			     background job, so without this a manual on a network share
			     would show an empty window for as long as the read took. -->
			<control type="label">
				<left>60</left>
				<top>40</top>
				<width>1800</width>
				<height>940</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font13</font>
				<textcolor>grey</textcolor>
				<label>$INFO[Window.Property(Manual.Status)]</label>
				<visible>!String.IsEmpty(Window.Property(Manual.Status))</visible>
			</control>

			<!-- A zoomed page fills the screen and passes under the labels, so
			     they are given something to sit on rather than being read
			     against whatever happens to be on the paper -->
			<control type="image">
				<left>0</left>
				<top>960</top>
				<width>100%</width>
				<height>120</height>
				<texture colordiffuse="dd000000">colors/white.png</texture>
			</control>

			<control type="label">
				<left>60</left>
				<top>1000</top>
				<width>900</width>
				<height>40</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>font12</font>
				<textcolor>white</textcolor>
				<label>$INFO[Window.Property(Manual.Title)]</label>
			</control>

			<!-- Only says anything while zoomed in, since a page shown whole is
			     the normal case and needs no announcement -->
			<control type="label">
				<left>760</left>
				<top>1000</top>
				<width>400</width>
				<height>40</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font12</font>
				<textcolor>grey</textcolor>
				<label>$INFO[Window.Property(Manual.ZoomLabel)]</label>
			</control>

			<control type="label">
				<left>960</left>
				<top>1000</top>
				<width>900</width>
				<height>40</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>font12</font>
				<textcolor>grey</textcolor>
				<label>$INFO[Window.Property(Manual.PageLabel)]</label>
			</control>
		</control>
	</controls>
</window>
